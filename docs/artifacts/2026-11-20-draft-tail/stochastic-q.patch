+// The 8 best by (value, then lower index), NaN as -inf, from a host sort.
+std::vector<int32_t> HostTop8(const std::vector<float>& x) {
+  std::vector<int32_t> order(x.size());
+  std::iota(order.begin(), order.end(), 0);
+  auto key = [&](int32_t i) { return std::isnan(x[i]) ? -INFINITY : x[i]; };
+  std::partial_sort(order.begin(), order.begin() + 8, order.end(), [&](int32_t a, int32_t b) {
+    return key(a) > key(b) || (key(a) == key(b) && a < b);
+  });
+  order.resize(8);
+  return order;
+}
+
+void TestTop8() {
+  float* work = Device(std::vector<float>(hy4_top8_work_floats()));
+  int32_t* ids = Device(std::vector<int32_t>(8));
+  float* vals = Device(std::vector<float>(8));
+  auto check = [&](const std::vector<float>& x, const std::string& what) {
+    Expect(hy4_top8(Device(x), (uint32_t)x.size(), work, ids, vals, nullptr) == 0, what + " status");
+    const auto want = HostTop8(x);
+    Expect(Host(ids, 8) == want, what + " ids");
+    const auto got = Host(vals, 8);
+    bool same = true;
+    for (int j = 0; j < 8; ++j) {
+      const float w = std::isnan(x[want[j]]) ? -INFINITY : x[want[j]];
+      same &= got[j] == w;
+    }
+    Expect(same, what + " values");
+  };
+  // The Hy4 vocabulary: ties across blocks, +inf, NaN and a run of equal values.
+  auto x = Random(120832, -4, 4);
+  x[77001] = x[501] = 9.0f;
+  x[64000] = INFINITY;
+  x[3] = NAN;
+  for (int i = 0; i < 6; ++i) x[100000 + 7 * i] = 6.0f;
+  x[100100] = 6.0f;
+  check(x, "top8 vocab");
+  // Fewer finite values than 8; most blocks hold only -inf.
+  std::vector<float> sparse(5000, -INFINITY);
+  sparse[4999] = 1.0f;
+  sparse[17] = NAN;
+  sparse[2500] = 2.0f;
+  check(sparse, "top8 sparse");
+  check(Random(8), "top8 eight");
+  check(Random(1000), "top8 small");
+}
+
+void TestQuantizeHalf() {
