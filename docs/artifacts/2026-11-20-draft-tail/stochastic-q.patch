diff --git a/tests/draft_sampling_test.cpp b/tests/draft_sampling_test.cpp
new file mode 100644
index 0000000..e3e993c
--- /dev/null
+++ b/tests/draft_sampling_test.cpp
@@ -0,0 +1,117 @@
+// Speculative sampling with DFly2 proposals: ProposeDraft and VerifyDraft
+// together must emit tokens distributed exactly as the target's own sampler,
+// for diffuse proposals (p / q and residual draws), point masses, and
+// proposals holding tokens the target's filters exclude.
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "draft_sampling.hpp"
+
+namespace {
+
+using gufo::models::hy4_flash::DraftProposal;
+using gufo::models::hy4_flash::ProposeDraft;
+using gufo::models::hy4_flash::VerifyDraft;
+namespace sampling = gufo::sampling;
+
+int g_failures = 0;
+
+void Expect(bool ok, const std::string& what) {
+  if (!ok) {
+    std::fprintf(stderr, "FAIL %s\n", what.c_str());
+    ++g_failures;
+  }
+}
+
+sampling::SamplingConfig Config(float temperature, float top_p) {
+  sampling::SamplingConfig config;
+  config.temperature = temperature;
+  config.top_p = top_p;
+  config.seed = 20261120;
+  return config;
+}
+
+// Draws `trials` tokens through propose + verify and compares their
+// frequencies with the target distribution.
+void CheckExact(const sampling::SamplingConfig& config, const std::vector<float>& target,
+                const std::array<std::int32_t, 8>& ids, const std::array<float, 8>& draft, const std::string& what,
+                std::size_t* point_masses = nullptr) {
+  sampling::SamplerState sampler(config);
+  const auto p = sampler.Distribution(target);
+  constexpr int kTrials = 400000;
+  std::vector<int> counts(target.size());
+  std::size_t points = 0;
+  for (int t = 0; t < kTrials; ++t) {
+    const DraftProposal proposal = ProposeDraft(sampler, ids, draft);
+    points += proposal.size == 1;
+    double mass = 0;
+    for (std::size_t i = 0; i < proposal.size; ++i) mass += proposal.probabilities[i];
+    if (std::fabs(mass - 1.0) > 1e-6) {
+      Expect(false, what + ": q does not sum to one");
+      return;
+    }
+    const auto token = VerifyDraft(sampler, target, proposal);
+    ++counts.at(static_cast<std::size_t>(token));
+  }
+  double worst = 0;
+  for (std::size_t v = 0; v < target.size(); ++v) {
+    const double want = p.probability(static_cast<sampling::TokenId>(v));
+    const double got = static_cast<double>(counts[v]) / kTrials;
+    const double sigma = std::sqrt(std::max(want * (1 - want), 1e-9) / kTrials);
+    worst = std::max(worst, std::fabs(got - want) / sigma);
+    if (want == 0 && counts[v] != 0) Expect(false, what + ": emitted a token the target excludes");
+  }
+  Expect(worst < 5.0, what + ": frequencies off by " + std::to_string(worst) + " sigma");
+  if (point_masses) *point_masses = points;
+}
+
+}  // namespace
+
+int main() {
+  std::mt19937 rng(7);
+  std::uniform_real_distribution<float> dist(-2, 2);
+  std::vector<float> target(24);
+  for (float& x : target) x = dist(rng);
+  // The drafter's candidates: some the target likes, some it does not.
+  const std::array<std::int32_t, 8> ids{3, 17, 0, 9, 22, 5, 11, 14};
+  std::array<float, 8> diffuse{};
+  for (std::size_t i = 0; i < 8; ++i) diffuse[i] = 1.0f - 0.15f * static_cast<float>(i);
+  std::size_t points = 1;
+  CheckExact(Config(0.9F, 1.0F), target, ids, diffuse, "diffuse q, T 0.9", &points);
+  Expect(points == 0, "a diffuse q is not a point mass");
+  CheckExact(Config(0.6F, 0.8F), target, ids, diffuse, "diffuse q, T 0.6, top-p 0.8");
+
+  std::array<float, 8> sharp = diffuse;
+  sharp[0] = 8.0f;
+  CheckExact(Config(0.9F, 1.0F), target, ids, sharp, "point mass", &points);
+  Expect(points == 400000, "a concentrated q is a point mass");
+
+  // The draw follows q: token frequencies of the proposals themselves.
+  {
+    sampling::SamplerState sampler(Config(1.0F, 1.0F));
+    std::array<int, 24> seen{};
+    for (int t = 0; t < 200000; ++t) ++seen[static_cast<std::size_t>(ProposeDraft(sampler, ids, diffuse).token)];
+    double z = 0;
+    for (std::size_t i = 0; i < 8; ++i) z += std::exp(diffuse[i] - diffuse[0]);
+    double worst = 0;
+    for (std::size_t i = 0; i < 8; ++i) {
+      const double want = std::exp(diffuse[i] - diffuse[0]) / z;
+      worst = std::max(worst, std::fabs(seen[static_cast<std::size_t>(ids[i])] / 200000.0 - want) /
+                                  std::sqrt(want * (1 - want) / 200000));
+    }
+    Expect(worst < 5.0, "proposals follow q (" + std::to_string(worst) + " sigma)");
+  }
+
+  if (g_failures) {
+    std::fprintf(stderr, "%d failures\n", g_failures);
+    return 1;
+  }
+  std::printf("hy4 draft sampling: all checks passed\n");
+  return 0;
+}
