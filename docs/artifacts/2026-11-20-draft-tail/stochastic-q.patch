+// The kTop best of a row, best first: larger value, then lower index (NaN
+// counts as -inf). Each thread keeps a sorted list of its elements, and the
+// block merges the lists in kTop rounds, the winner's thread popping its head.
+constexpr uint32_t kTop = 8, kTopBlocks = 64;
+
+__device__ __forceinline__ bool Better(float a, int32_t ia, float b, int32_t ib) {
+  return a > b || (a == b && ia < ib);
+}
+
+// Rows of `count` candidates per block, from x (with indices idx, or their
+// positions); block b writes its kTop to out_v/out_i [b][kTop].
+__global__ void TopRows(const float* x, const int32_t* idx, uint32_t count, uint32_t chunk, float* out_v,
+                        int32_t* out_i) {
+  __shared__ float sv[kBlock / 32];
+  __shared__ int32_t si[kBlock / 32];
+  float v[kTop];
+  int32_t id[kTop];
+#pragma unroll
+  for (uint32_t j = 0; j < kTop; ++j) {
