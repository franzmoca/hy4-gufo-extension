+  for (uint32_t i = lo + threadIdx.x; i < hi; i += blockDim.x) {
+    float e = x[i];
+    if (e != e) e = -INFINITY;
+    const int32_t ie = idx ? idx[i] : (int32_t)i;
+    if (!Better(e, ie, v[kTop - 1], id[kTop - 1])) continue;
+    v[kTop - 1] = e;
+    id[kTop - 1] = ie;
+#pragma unroll
+    for (uint32_t j = kTop - 1; j > 0; --j) {
+      if (Better(v[j], id[j], v[j - 1], id[j - 1])) {
+        const float tv = v[j];
+        const int32_t ti = id[j];
+        v[j] = v[j - 1];
