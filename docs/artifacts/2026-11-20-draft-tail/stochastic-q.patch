+int hy4_top8(const float* x, uint32_t dim, float* work, int32_t* ids, float* vals, hipStream_t stream) {
+  if (dim < kTop) return 1;
+  float* part_v = work;
+  int32_t* part_i = reinterpret_cast<int32_t*>(work + kTopBlocks * kTop);
+  const uint32_t chunk = (dim + kTopBlocks - 1) / kTopBlocks;
+  TopRows<<<kTopBlocks, kBlock, 0, stream>>>(x, nullptr, dim, chunk, part_v, part_i);
+  TopRows<<<1, kBlock, 0, stream>>>(part_v, part_i, kTopBlocks * kTop, kTopBlocks * kTop, vals, ids);
+  return Status();
+}
+
+int hy4_quantize_q8_0_half(const uint16_t* src, uint64_t blocks, void* dst, hipStream_t stream) {
+  if (blocks == 0) return 0;
+  QuantizeQ8Half<<<(blocks + kBlock - 1) / kBlock, kBlock, 0, stream>>>(
+      reinterpret_cast<const _Float16*>(src), static_cast<BlockQ8_0*>(dst), blocks);
   return Status();
 }
 
