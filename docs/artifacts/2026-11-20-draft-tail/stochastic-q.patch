+// Q8_0 blocks of 32 binary16 values: d = max |v| / 127, q = round(v / d).
+__global__ void QuantizeQ8Half(const _Float16* src, BlockQ8_0* dst, uint64_t blocks) {
+  const uint64_t b = (uint64_t)blockIdx.x * blockDim.x + threadIdx.x;
+  if (b >= blocks) return;
+  float v[32];
+  float amax = 0.0f;
+#pragma unroll
+  for (int i = 0; i < 32; ++i) {
+    v[i] = (float)src[b * 32 + i];
+    amax = fmaxf(amax, fabsf(v[i]));
+  }
+  const float d = amax / 127.0f;
+  const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+  dst[b].d = (__half)d;
+#pragma unroll
+  for (int i = 0; i < 32; ++i) dst[b].qs[i] = (int8_t)rintf(v[i] * inv);
 }
 
