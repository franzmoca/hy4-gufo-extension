+#ifndef HY4FLASH_DRAFT_SAMPLING_HPP_
+#define HY4FLASH_DRAFT_SAMPLING_HPP_
+
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <gufo/ext/sampling.hpp>
+#include <span>
+#include <stdexcept>
+
+namespace gufo::models::hy4_flash {
+
+/// A draft token and the distribution q it was drawn from, for exact
+/// speculative sampling: the target keeps it with probability
+/// min(1, p / q) and otherwise draws from the residual max(0, p - q).
+struct DraftProposal {
+  static constexpr std::size_t kCandidates = 8;
+  std::array<sampling::TokenId, kCandidates> ids{};
+  std::array<float, kCandidates> probabilities{};
+  std::size_t size = 0;  // 1: a point mass on `token`
+  sampling::TokenId token{};
+  float probability = 0;
+  float best = 0;  // q's largest probability
+};
+
+/// Drafts from the drafter's best candidates (logits, best first): q is
+/// their softmax at the request's temperature, or a point mass on the best
+/// when it holds at least 0.7 of q (concentrated proposals are accepted more
+/// often as point masses). q is held in 2^-24 units, so it sums to exactly
+/// one; one uniform from the request's generator draws the token.
+inline DraftProposal ProposeDraft(sampling::SamplerState& sampler,
+                                  std::span<const std::int32_t, DraftProposal::kCandidates> ids,
+                                  std::span<const float, DraftProposal::kCandidates> logits) {
+  for (std::size_t i = 0; i < ids.size(); ++i) {
+    if (std::isnan(logits[i]) || logits[i] == INFINITY) throw std::invalid_argument("non-finite draft logit");
+    if (ids[i] < 0) throw std::invalid_argument("invalid draft token");
+  }
+  sampling::SamplingConfig config;
+  config.temperature = sampler.config().temperature;
+  const auto q = sampling::BuildDistribution(logits, config);
+  const auto best = q.best_token();
+  DraftProposal proposal;
+  proposal.best = static_cast<float>(q.probability(best));
+  if (q.probability(best) >= 0.7) {
+    proposal.size = 1;
+    proposal.ids[0] = proposal.token = static_cast<sampling::TokenId>(ids[best]);
+    proposal.probabilities[0] = proposal.probability = 1.0F;
+    return proposal;
+  }
+  constexpr std::uint32_t kUnits = 1U << 24;
+  std::array<std::uint32_t, DraftProposal::kCandidates> masses{};
+  std::uint32_t total = 0;
+  for (const auto& entry : q.entries()) {
+    proposal.ids[proposal.size] = static_cast<sampling::TokenId>(ids[entry.token]);
+    masses[proposal.size] = static_cast<std::uint32_t>(std::floor(entry.value * kUnits));
+    total += masses[proposal.size++];
+  }
+  masses[0] += kUnits - total;
+  const auto draw = static_cast<std::uint32_t>(sampler.Uniform() * kUnits);
+  std::uint32_t cumulative = 0;
+  for (std::size_t i = 0; i < proposal.size; ++i) {
+    proposal.probabilities[i] = static_cast<float>(masses[i]) / kUnits;
+    cumulative += masses[i];
+    if (proposal.probability == 0 && draw < cumulative) {
+      proposal.token = proposal.ids[i];
+      proposal.probability = proposal.probabilities[i];
+    }
+  }
+  return proposal;
+}
+
+/// The target's token at a drafted position, distributed exactly as
+/// sampler.Sample(logits) would be. A point mass, or a forced token, samples
+/// the target and compares; otherwise p / q acceptance with a residual draw.
+/// Does not Accept the token.
+inline sampling::TokenId VerifyDraft(sampling::SamplerState& sampler, std::span<const float> logits,
+                                     const DraftProposal& proposal) {
+  if (proposal.size <= 1 || sampler.ForcedToken()) return sampler.Sample(logits);
+  const auto target = sampler.Distribution(logits);
+  if (sampler.Uniform() * proposal.probability < target.probability(proposal.token)) return proposal.token;
+  return target.SampleResidual(std::span(proposal.ids).first(proposal.size),
+                               std::span(proposal.probabilities).first(proposal.size),
+                               sampler.mutable_rng_state());
+}
+
+}  // namespace gufo::models::hy4_flash
+
+#endif  // HY4FLASH_DRAFT_SAMPLING_HPP_
